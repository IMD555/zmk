#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/led_indicators.h>

#define DEFAULT         0
#define US2JIS          1
#define US2JIS_SHIFT    2
#define US2JIS_DUMMY    3
#define FN              4

/ {
    macros {
        jis_shift: jis_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_press &mo US2JIS_SHIFT>
                , <&macro_pause_for_release>
                , <&macro_release &mo US2JIS_SHIFT>
                , <&macro_release &kp LSHFT>
                ;
        };

        // JIS normal US shift
        at: at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo US2JIS_DUMMY>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp LBKT>
//                , <&macro_press &kp LBKT>
//                , <&macro_pause_for_release>
//                , <&macro_release &kp LBKT>
//                , <&macro_press &kp LSHFT>
                , <&macro_release &mo US2JIS_DUMMY>
                ;
        };
        hat: hat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo US2JIS_DUMMY>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp EQUAL>
//                , <&macro_press &kp EQUAL>
//                , <&macro_pause_for_release>
//                , <&macro_release &kp EQUAL>
//                , <&macro_press &kp LSHFT>
                , <&macro_release &mo US2JIS_DUMMY>
                ;
        };
        colon: colon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo US2JIS_DUMMY>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp SQT>
//                , <&macro_press &kp SQT>
//                , <&macro_pause_for_release>
//                , <&macro_release &kp SQT>
//                , <&macro_press &kp LSHFT>
                , <&macro_release &mo US2JIS_DUMMY>
                ;
        };

        // JIS shift US normal
        equal: equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo US2JIS_DUMMY>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp MINUS>
                , <&macro_release &kp LSHFT>
//                , <&macro_press &kp LSHFT &kp MINUS>
//                , <&macro_pause_for_release>
//                , <&macro_release &kp MINUS &kp LSHFT>
                , <&macro_release &mo US2JIS_DUMMY>
                ;
        };
        sqt: sqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo US2JIS_DUMMY>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N7>
                , <&macro_release &kp LSHFT>
//                , <&macro_press &kp LSHFT &kp N7>
//                , <&macro_pause_for_release>
//                , <&macro_release &kp N7 &kp LSHFT>
                , <&macro_release &mo US2JIS_DUMMY>
                ;
        };
        grav: grav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo US2JIS_DUMMY>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp LBKT>
                , <&macro_release &kp LSHFT>
//                , <&macro_press &kp LSHFT &kp LBKT>
//                , <&macro_pause_for_release>
//                , <&macro_release &kp LBKT &kp LSHFT>
                , <&macro_release &mo US2JIS_DUMMY>
                ;
        };

        sel0_0: sel0_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_1: sel0_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp N5>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_2: sel0_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp N6>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_3: sel0_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp N7>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_4: sel0_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp N8>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_5: sel0_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp N9>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_6: sel0_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp N0>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_7: sel0_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp MINUS>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_8: sel0_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp EQUAL>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        sel0_9: sel0_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp GRAV>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        
        sel1_0: sel1_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp Q>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
        
        sel1_1: sel1_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT &kp LSHFT>
                , <&macro_tap &kp Q>
                , <&macro_release &kp LCTRL &kp LALT &kp LSHFT>
                ;
        };
        
        sel1_2: sel1_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT &kp LSHFT>
                , <&macro_tap &kp W>
                , <&macro_release &kp LCTRL &kp LALT &kp LSHFT>
                ;
        };
        
        sel1_3: sel1_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp W>
                , <&macro_release &kp LCTRL &kp LALT>
                ;
        };
    };

    behaviors {
        sel0: selector_0 {
            compatible = "zmk,behavior-selector";
            #binding-cells = <1>;
            bindings = <&sel0_0>, <&sel0_1>, <&sel0_2>, <&sel0_3>, <&sel0_4>, <&sel0_5>, <&sel0_6>, <&sel0_8>, <&sel0_9>;
        };
        sel1: selector_1 {
            compatible = "zmk,behavior-selector";
            #binding-cells = <1>;
            bindings = <&sel1_0>, <&sel1_1>, <&sel1_2>, <&sel1_3>;
            loop;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp GRAV &kp BSLH
            &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSPC
            &mo FN  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT           &kp RET
            &kp LSHFT   &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH           &kp RSHFT &kp UP &kp DEL
            &kp LCTRL &kp LGUI &kp LALT &kp LANG2    &kp SPACE    &kp LANG1            &kp RALT  &mo FN   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        jis_layer {
            bindings = <
            &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &equal &grav &kp INT_YEN
            &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp RBKT  &kp BSLH  &kp BSPC
            &mo FN  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &sqt           &kp RET
            &jis_shift   &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH           &jis_shift &kp UP &kp DEL
            &kp LCTRL &kp LGUI &kp LALT &kp LANG2    &kp SPACE    &kp LANG1            &kp RALT  &mo FN   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        jis_shift_layer {
            bindings = <
            &kp ESC &kp N1 &at &kp N3 &kp N4 &kp N5 &hat &kp N6 &kp SQT &kp N8 &kp N9 &kp INT_RO &kp SEMI &kp EQUAL &kp INT_YEN
            &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp RBKT  &kp BSLH  &kp BSPC
            &none  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &colon &kp N2           &kp RET
            &none   &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH           &none &kp UP &kp DEL
            &kp LCTRL &kp LGUI &kp LALT &kp LANG2    &kp SPACE    &kp LANG1            &kp RALT  &none   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        jis_dummy_layer {
            bindings = <
            &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none &none           &none
            &none   &none  &none  &none  &none  &none  &none  &none  &none &none &none           &none &none &none
            &none &none &none &none    &none    &none            &none  &none   &none  &none  &none
            >;
        };

        fn_layer {
            bindings = <
            &kp C_MUTE  &ind BAT &kp F2 &kp F3  &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10  &kp F11 &kp F12 &kp F13 &kp F14
            &kp TAB &kp C_BRI_UP &kp C_VOL_UP &kp F15 &kp F16 &kp F17 &kp F18 &kp F19 &kp F20 &kp F21 &kp F22 &kp F23 &kp F24 &bt BT_CLR
            &kp CAPS  &kp C_PREV  &kp C_PP  &kp C_NEXT  &none  &none  &none  &tog US2JIS  &none  &none  &none &none           &kp RET
            &kp LSHFT  &kp C_BRI_DN &kp C_VOL_DN &none &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &kp RSHFT &kp PG_UP &none
            &kp LCTRL &kp LGUI &kp LALT &none    &kp SPACE    &none          &kp RALT  &kp K_MENU   &kp HOME  &kp PG_DN  &kp END
            >;
        };
    };
};
