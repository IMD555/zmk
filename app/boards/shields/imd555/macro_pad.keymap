#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/selector.h>

#define DEFAULT   0
#define FN        1

&mt {
    tapping-term-ms = <400>;
};

/ {

    behaviors {
        td_redo_undo: tap_dance_redo_undo {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LC(Y)>,<&kp LC(Z)>;
        };

        td_via_junction: tap_dance_via_junction {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LA(V)>, <&kp LC(J)>;
        };

        td_name_value: tap_dance_name_value {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp N>,<&kp V>;
        };

        td_move_split: tap_dance_move_split {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp M>,<&kp L>;
        };

        td_show_sch_brd: tap_dance_show_sch_brd {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp W>,<&kp LC(N1)>,<&kp LC(N2)>;
        };

        td_poly_hide_show: tap_dance_poly_hidefill_showfill {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LC(LS(P))>,<&kp LC(LS(O))>,<&kp LC(LS(I))>;
        };

        td_singlelayer_flipboard: tap_dance_singlelayer_flipboard {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LC(T)>,<&kp LC(LS(LA(F)))>;
        };

        td_line_optimize: tap_dance_line_optimize {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LC(L)>,<&kp LC(LS(LA(O)))>;
        };

        td_net_unroute_del: tap_dance_net_unroute_del {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp R>,<&kp LC(LS(LA(R)))>,<&kp LC(LS(D))>;
        };

        td_12345: tap_dance_12345 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp N1>,<&kp N2>,<&kp N3>,<&kp N4>,<&kp N5>;
        };

        td_67890: tap_dance_67890 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp N6>,<&kp N7>,<&kp N8>,<&kp N9>,<&kp N0>;
        };

        td_munp: tap_dance_munp {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp M>,<&kp U>,<&kp N>,<&kp P>;
        };

        td_dkM: tap_dance_dkM {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp DOT>,<&kp K>,<&kp LS(M)>;
        };

        sel0: selector_0 {
            compatible = "zmk,behavior-selector";
            #binding-cells = <1>;
            bindings =
                <&kp LC(LA(DOT))>,      <&sel0 5>,        // LCTRL + LALT + .  : layer 25;
                <&kp DOT>,              <&sel0 4>,        // LCTRL + LSHFT + . : layer 1;
                <&kp LC(LS(DOT))>,      <&sel0 3>,        // .                 : layer 2;
                <&kp LC(LS(COMMA))>,    <&sel0 2>,        // ,                 : layer 15;
                <&kp COMMA>,            <&sel0 1>,        // LCTRL + LSHFT + , : layer 16;
                <&kp LC(LA(COMMA))>,    <&sel0 0>;        // LCTRL + LALT + ,  : layer 26;
            selection-default = <1>;
            separate-pushed;
        };

        sel1: selector_1 {
            compatible = "zmk,behavior-selector";
            #binding-cells = <1>;
            bindings =
                <&kp LC(LA(N4))>,       <&sel1 2>,  // LCTRL + LALT + 4 : Set width 0.2;
                <&kp LC(LA(N5))>,       <&sel1 2>,  // LCTRL + LALT + 5 : Set width 0.25;
                <&kp LC(LA(N6))>,       <&sel1 1>,  // LCTRL + LALT + 6 : Set width 0.3;
                <&kp LC(LA(N7))>,       <&sel1 1>,  // LCTRL + LALT + 7 : Set width 0.4;
                <&kp LC(LA(N8))>,       <&sel1 1>,  // LCTRL + LALT + 8 : Set width 0.6;
                <&kp LC(LA(N9))>,       <&sel1 1>,  // LCTRL + LALT + 9 : Set width 1.0;
                <&kp LC(LA(N0))>,       <&sel1 1>,  // LCTRL + LALT + 0 : Set width 1.4;
                <&kp LC(LA(MINUS))>,    <&sel1 1>,  // LCTRL + LALT + - : Set width 2.0;
                <&kp LC(LA(EQUAL))>,    <&sel1 1>,  // LCTRL + LALT + = : Set width 3.0;
                <&kp LC(LA(GRAV))>,     <&sel1 1>;  // LCTRL + LALT + ` : Set width 5.0;
            selection-default = <3>;
            separate-pushed;
        };

        rot_sel0: sensor_rotate_sel0 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&sel0 SEL_NEXT>, <&sel0 SEL_PREV>;
        };

        rot_sel1: sensor_rotate_sel1 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&sel1 SEL_NEXT>, <&sel1 SEL_PREV>;
        };

        mm_a: mm_a {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&td_singlelayer_flipboard>, <&kp A>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };
        mm_z: mm_z {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp Z>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };
        mm_x: mm_x {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&td_move_split>, <&kp X>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };
        mm_c: mm_c {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&td_net_unroute_del>, <&kp C>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };
        mm_v: mm_v {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&td_name_value>, <&kp V>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                        &td_poly_hide_show  &td_12345           &td_67890
            &kp TAB     &td_show_sch_brd    &td_munp            &td_dkM             &kp BSPC
            &mo FN      &mm_a               &sel0 SEL_PUSH      &sel1 SEL_PUSH      &kp RET
            &kp LSHFT   &mm_z               &mm_x               &mm_c               &mm_v
            &kp LCTRL   &td_line_optimize   &td_via_junction    &td_redo_undo       &kp LALT
            >;

            sensor-bindings = <&rot_sel0 &rot_sel1>;
        };
        fn_layer {
            bindings = <
                            &none           &none               &none
            &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2        &bt BT_SEL 3        &bt BT_SEL 4
            &mo FN          &none           &none               &none               &bt BT_CLR
            &none           &none           &none               &none               &none
            &none           &none           &none               &none               &kp LALT
            >;

            sensor-bindings = <&rot_sel0 &rot_sel1>;
        };
    };
};
